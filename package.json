{
  "name": "cli-use-core",
  "version": "0.0.20",
  "description": "AI-powered CLI adapter tool",
  "keywords": [
    "adapter",
    "ai",
    "cli"
  ],
  "homepage": "https://github.com/cliuse-me/CLI-USE#readme",
  "bugs": {
    "url": "https://github.com/cliuse-me/CLI-USE/issues"
  },
  "license": "MIT",
  "author": "Adapter Engineer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cliuse-me/CLI-USE.git"
  },
  "bin": {
    "cli-use-core": "dist/cli.js"
  },
  "files": [
    "dist",
    ".claude-plugin"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/opencode-plugin.d.ts",
      "import": "./dist/opencode-plugin.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pack": "tsx scripts/test-pack.ts",
    "release": "node run-release.js",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.2.22",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "2.1.8",
    "globals": "^17.4.0",
    "np": "^11.0.2",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "2.1.8"
  }
}
