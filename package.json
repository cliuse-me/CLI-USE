{
    "name": "cli-use-tdd",
    "version": "0.0.1",
    "type": "module",
    "bin": {
        "planner": "./dist/index.js"
    },
    "scripts": {
        "dev": "tsx src/index.tsx",
        "build": "tsup src/index.tsx --format esm --clean",
        "start": "node dist/index.js",
        "lint": "oxlint && eslint .",
        "typecheck": "tsc --noEmit",
        "oxlint": "oxlint"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^1.1.0",
        "@ai-sdk/google": "^3.0.43",
        "@ai-sdk/groq": "^3.0.29",
        "@ai-sdk/openai": "^1.1.0",
        "ai": "^6.0.86",
        "dotenv": "^16.4.5",
        "fs-extra": "^11.2.0",
        "ink": "npm:@jrichman/ink@6.4.10",
        "ink-spinner": "^5.0.0",
        "ink-text-input": "^5.0.1",
        "lowdb": "^7.0.1",
        "ollama-ai-provider": "^1.2.0",
        "react": "^19.2.4",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.3",
        "@types/eslint": "^9.6.1",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^22.10.0",
        "@types/react": "^19.2.14",
        "eslint": "^9.39.3",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^17.4.0",
        "oxlint": "^1.51.0",
        "tsup": "^8.3.5",
        "tsx": "^4.19.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.56.1"
    },
    "overrides": {
        "ink-text-input": {
            "ink": "$ink",
            "react": "$react"
        },
        "ink-spinner": {
            "ink": "$ink",
            "react": "$react"
        }
    }
}
